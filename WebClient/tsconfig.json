<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'
import { useOwidStore } from '~/stores/owid'

const config = useNuxtApp().$config || {}
const store = useOwidStore()
const searchComponent = ref()
const tutorial = ref(false)
const tutorialIframeSrc = ref('')
const alert = ref(false)
const newsSelected = ref(-1)
const news = ref([
  { id: 0, title: 'Version 3.0', date: '2025-10-07', text: 'Die neue API basiert auf dem <a href="https://notes.jan-oliver-ruediger.de/software/corpusexplorer-overview/">CorpusExplorer</a>.', icon: 'mdi-xml' },
  { id: 1, title: 'Daten-Crash', date: '2025-09-05', text: 'Die Daten im Zeitraum 03.07.-04.09.2025 sind verloren gegangen.', icon: 'mdi-alert-decagram-outline' },
  { id: 2, title: 'Print-Publikation', date: '2024-06-27', text: 'OpenAccess Artikel verfügbar.', icon: 'mdi-book-open-variant' }
])

const totalLabel = computed(() => {
  if (store.owid === null) return ''
  const totals = store.owid.Total
  return totals.map((value, index) => `N=${index + 1}: ${value}`).join(' / ')
})

const newsAll = computed({
  get: () => (newsSelected.value === -1 ? 0 : 1),
  set: () => {}
})

function newProject() {
  location.reload()
}

function showTutorial() {
  tutorial.value = false
}

function setLocale(locale: string) {
  localStorage.setItem('locale', locale)
  const { $i18n } = useNuxtApp()
  if ($i18n && $i18n.locale !== undefined) {
    $i18n.locale = locale
  }
}

function closeTutorial() {
  localStorage.setItem('tutorial', new Date().toISOString())
  tutorial.value = true
}

function scrollToVizPanel() {
  document.getElementById('vizPanel')?.scrollIntoView({ behavior: 'smooth', block: 'start' })
  window.scrollBy(0, -100)
}

onMounted(() => {
  const locale = localStorage.getItem('locale')
  if (locale) setLocale(locale)

  const tutorialDate = localStorage.getItem('tutorial')
  if (tutorialDate) {
    const last = new Date(tutorialDate)
    if (Number.isNaN(last.getTime())) {
      tutorial.value = false
    } else {
      tutorial.value = Date.now() - last.getTime() < 86400000
    }
  } else {
    tutorial.value = false
  }

  const baseUrl = 'https://www.owid.de/plus/live-2021/api/v3'

  fetch(baseUrl + '/years')
    .then((response) => response.json())
    .then((response) => {
      store.setYears(response)

      return fetch(baseUrl + '/norm', { method: 'GET' })
    })
    .then((resp) => {
      if (resp.status !== 200) throw new Error('Server Error')
      return resp.json()
    })
    .then((obj) => {
      store.init(obj)
      store.vizOption({ r: true, s: 16, g: 1 })
    })
    .catch((ex) => {
      console.error(ex)
      alert.value = true
    })

  if (!config.tutorialUrl || config.tutorialUrl.length < 1) {
    tutorial.value = true
  } else {
    tutorialIframeSrc.value = config.tutorialUrl
  }
})
</script>

